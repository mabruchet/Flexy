{% set steps = this.steps %}
{% set current = this.currentPosition %}
{% set percent = steps|length > 0 ? (current / steps|length * 100)|round : 0 %}

<div class="{{ ('CheckoutSteps ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="flex items-center">
        <div class="CheckoutSteps-mobile">
            <div class="w-5 h-5 mr-0.5">
                {{ ux_icon('chevron-left') }}
            </div>
        </div>
        <div class="CheckoutSteps-steps">
            {% for step_item in steps %}
                <div class="Step {% if loop.index == current %}current{% elseif loop.index > current %}next{% else %}previous{% endif %}">
                    <span class="Step-number" style="--p: {{ percent }}%;">
                        <span>{{ loop.index }}</span>
                    </span>
                    <span class="Step-label">
                        {% if current != loop.length and loop.index <= current %}
                            {% if step_item.link %}<a href="{{ step_item.link }}" class="no-underline">{% endif %}
                        {% endif %}
                        {{- step_item.translate|default(true) ? step_item.text|trans : step_item.text -}}
                        {% if current != loop.length and loop.index <= current %}
                            {% if step_item.link %}</a>{% endif %}
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
        </div>
    </div>
    {% if not this.noCart %}
        <twig:Organisms:Summary:Mini />
    {% endif %}
</div>
