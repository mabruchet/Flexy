{# @prop orderReturn array A return as the /api/front/account/order_returns collection hands it over #}
{# @prop withOrder boolean Whether to link the order the return belongs to. Defaults to `false`, for a list already scoped to one order #}
{% props orderReturn, withOrder = false %}

{% set statusCode = orderReturn.orderReturnStatus.code|default('') %}

<li class="{{ ('flex flex-wrap items-center justify-between gap-3 border border-grey-lighter rounded-lg p-4 ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="flex flex-col gap-1">
        <twig:Molecules:Link:Base
            href="{{ path('account_return', {returnId: orderReturn.id}) }}"
            customText="{{ 'Return %ref%'|trans({'%ref%': orderReturn.ref}) }}"
        />
        <span class="paragraph-3">{{ orderReturn.createdAt|format_date() }}</span>
        {% if withOrder %}
            <twig:Molecules:Link:Base
                href="{{ path('account_order', {orderId: orderReturn.orderId}) }}"
                customText="{{ 'Order N°'|trans ~ ' ' ~ orderReturn.orderRef }}"
                size="small"
            />
        {% endif %}
    </div>
    <twig:Molecules:Tag:OrderReturn
        status="{{ statusCode }}"
        customText="{{ orderReturn.orderReturnStatus.i18ns.title|default(statusCode) }}"
    />
</li>
