{# A payment method the customer asked the shop to keep, on the account page. Same card as the
   address book, so it takes its classes and its confirmation behaviour (the dialog target and
   the action it submits come from the trigger): no style of its own.
   @prop method array The payment method as the account API reads it: id, label, paymentModuleTitle, expiresAt, isDefault
   @prop deleteUrl string POST target of the deletion, confirmed in the dialog `confirmDeletePaymentMethod`
   @prop defaultUrl string POST target of the choice as default method, confirmed in the dialog `confirmDefaultPaymentMethod` #}
{% props method, deleteUrl, defaultUrl %}

{% set expiresAt = method.expiresAt|default(null) %}
{% set expired = expiresAt and expiresAt|date('Y-m-d') < 'now'|date('Y-m-d') %}

<div
    class="{{ ('AddressCard ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults(stimulus_controller('Organisms--AddressCard--base')).without('class') }}
    data-testid="payment-method"
>
    <div class="AddressCard-top">
        {% if method.isDefault %}
            <twig:Molecules:Favorite:Base text="{{ 'Default'|trans }}" selected />
        {% else %}
            <twig:Molecules:Favorite:Base
                text="{{ 'Default'|trans }}"
                data-modal="confirmDefaultPaymentMethod"
                data-confirm="{{ defaultUrl }}"
                {{ ...stimulus_action('Organisms--AddressCard--base', 'openModal', 'click') }}
            />
        {% endif %}
    </div>

    <div class="AddressCard-content">
        <span>
            <span class="AddressCard-title"><bdi>{{ method.label }}</bdi></span>
            <span class="AddressCard-name"><bdi>{{ method.paymentModuleTitle }}</bdi></span>
            {% if expiresAt %}
                <span class="AddressCard-address">
                    {% if expired %}
                        <twig:Molecules:Tag:Base color="error" customText="{{ 'Expired on %date%'|trans({'%date%': expiresAt|date('m/Y')}) }}" />
                    {% else %}
                        {{ 'Expires %date%'|trans({'%date%': expiresAt|date('m/Y')}) }}
                    {% endif %}
                </span>
            {% endif %}
        </span>
    </div>

    <div class="AddressCard-actions">
        <button
            type="button"
            {{ stimulus_action('Organisms--AddressCard--base', 'openModal', 'click') }}
            data-modal="confirmDeletePaymentMethod"
            data-confirm="{{ deleteUrl }}"
        >
            <span>{{ ux_icon('delete') }}</span>
            {{ 'Delete'|trans }}
        </button>
    </div>
</div>
