{# The block reads the signed-in customer's own returns, so it has nothing to show in the
   toolkit: what is worth looking at here is the list it draws, from static returns. #}
<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">Returns of an order</h4>
        <div class="flex flex-col gap-4">
            <h2 class="h4">Returns</h2>
            <ul class="flex flex-col gap-2 list-none p-0 m-0">
                <twig:Organisms:OrderReturnCard:Base :orderReturn="{id: 1, ref: 'RET000000000001', createdAt: '2026-09-12', orderReturnStatus: {code: 'requested', i18ns: {title: 'Requested'}}}" />
                <twig:Organisms:OrderReturnCard:Base :orderReturn="{id: 2, ref: 'RET000000000002', createdAt: '2026-09-02', orderReturnStatus: {code: 'settled', i18ns: {title: 'Settled'}}}" />
            </ul>
            <twig:Molecules:Button:Base text="Request a return" href="#" class="w-max" />
        </div>
    </div>
</div>
